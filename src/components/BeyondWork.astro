---
import { siteConfig } from "../config";

const iconSvgs: Record<string, string> = {
  camera: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>',
  globe: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>',
  sparkles: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z"/></svg>',
  leaf: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/></svg>',
  languages: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8l6 6"/><path d="M4 14l6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="M22 22l-5-10-5 10"/><path d="M14 18h6"/></svg>',
  home: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>',
  cube: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27,6.96 12,12.01 20.73,6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
};
---

<section id="beyond" class="py-20 px-6 md:px-12 lg:px-20" style="background-color: var(--color-surface);">
  <div class="max-w-5xl mx-auto">
    <h2 class="reveal text-sm uppercase tracking-[0.2em] font-medium mb-2" style="color: var(--color-accent);">Beyond the Graph</h2>
    <p class="reveal stagger-1 text-2xl md:text-3xl font-bold mt-4 mb-4" style="color: var(--color-primary-dark);">
      When I'm not building ontologies
    </p>
    <p class="reveal stagger-2 text-base mb-10 max-w-2xl" style="color: #777;">
      Outside of work, I'm driven by curiosity — from capturing moments through photography to experimenting with home automation and 3D printing. I love the intersection of creativity and technology.
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {siteConfig.beyondWork.map((hobby, i) => (
        <div class={`reveal stagger-${Math.min(i + 1, 6)} group p-5 rounded-xl text-center transition-all duration-300 hover:scale-[1.03]`}
             style="background-color: var(--color-surface-light); border: 1px solid var(--color-primary-light);">
          <div class="flex justify-center mb-3 transition-transform duration-300 group-hover:scale-110"
               style="color: var(--color-primary);"
               set:html={iconSvgs[hobby.icon] || ''} />
          <span class="text-sm font-medium" style="color: var(--color-primary-dark);">{hobby.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
