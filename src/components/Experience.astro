---
import { siteConfig } from "../config";
---

<section id="experience" class="py-20 px-6 md:px-12 lg:px-20" style="background-color: var(--color-surface-light);">
  <div class="max-w-5xl mx-auto">
    <h2 class="reveal text-sm uppercase tracking-[0.2em] font-medium mb-2" style="color: var(--color-accent);" data-i18n="experience.heading">Experience</h2>
    <p class="reveal stagger-1 text-2xl md:text-3xl font-bold mt-4 mb-12" style="color: var(--color-primary-dark);" data-i18n="experience.subtitle">
      Career Path
    </p>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-8 top-0 bottom-0 w-px" style="background-color: var(--color-primary-light);"></div>

      <div class="space-y-8">
        {siteConfig.experience.map((exp, i) => (
          <div class={`reveal stagger-${Math.min(i + 1, 4)} relative pl-12 md:pl-20`}>
            <!-- Timeline dot -->
            <div class={`absolute left-2.5 md:left-6.5 top-1 w-3 h-3 rounded-full border-2`}
                 style={`border-color: var(--color-primary); background-color: ${exp.current ? 'var(--color-accent)' : 'var(--color-surface-light)'};`}></div>

            <div class="card-hover p-5 rounded-xl" style="background-color: var(--color-surface); border: 1px solid var(--color-primary-light);">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-1 mb-2">
                <div>
                  <h3 class="text-base font-bold" style="color: var(--color-primary-dark);">
                    {exp.company}
                    {exp.companyNote && (
                      <span class="text-xs font-normal ml-1" style="color: #999;">({exp.companyNote})</span>
                    )}
                  </h3>
                  <p class="text-sm" style="color: var(--color-primary);" data-i18n={`exp.${i}.title`}>{exp.title}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs" style="color: #999;">{exp.period}</span>
                  {exp.current && (
                    <span class="text-[10px] px-2 py-0.5 rounded-full" style="background-color: var(--color-accent); color: #fff;" data-i18n="experience.current">
                      Current
                    </span>
                  )}
                </div>
              </div>
              <p class="text-xs mb-3" style="color: #aaa;">{exp.location}</p>
              {exp.bullets.length > 0 && (
                <ul class="space-y-1.5">
                  {exp.bullets.map((bullet, j) => (
                    <li class="text-sm flex items-start gap-2" style="color: #555;">
                      <span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0" style="background-color: var(--color-accent);"></span>
                      <span data-i18n={`exp.${i}.bullet.${j}`}>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mt-16">
      <h3 class="reveal text-sm uppercase tracking-[0.2em] font-medium mb-6" style="color: var(--color-accent);" data-i18n="experience.education">Education</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {siteConfig.education.map((edu, i) => (
          <div class={`reveal stagger-${i + 1} p-5 rounded-xl`}
               style="background-color: var(--color-surface); border: 1px solid var(--color-primary-light);">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h4 class="text-sm font-bold" style="color: var(--color-primary-dark);" data-i18n={`edu.${i}.degree`}>{edu.degree}</h4>
                <p class="text-xs mt-1" style="color: var(--color-primary);">{edu.school}</p>
                <p class="text-xs" style="color: #999;">{edu.faculty}</p>
              </div>
              <div class="text-right shrink-0">
                <span class="text-xs" style="color: #999;">{edu.period}</span>
                <div class="text-[10px] mt-0.5" style="color: var(--color-primary-light);">{edu.location}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
