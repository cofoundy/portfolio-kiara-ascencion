---
import { siteConfig } from "../config";

// Node positions — spread out more, bigger canvas
const nodePositions: Record<string, {x: number; y: number}> = {
  "Knowledge Graphs": { x: 420, y: 220 },
  "Ontology Engineering": { x: 200, y: 130 },
  "RDF": { x: 600, y: 110 },
  "SPARQL": { x: 680, y: 290 },
  "OWL": { x: 420, y: 60 },
  "RDFS": { x: 580, y: 40 },
  "NLP / LLM": { x: 180, y: 310 },
  "Python": { x: 80, y: 410 },
  "Protégé": { x: 80, y: 200 },
  "GraphDB": { x: 750, y: 190 },
  "RDFlib": { x: 320, y: 390 },
  "RML / R2RML": { x: 540, y: 370 },
  "SHACL": { x: 370, y: 310 },
};

// Pill dimensions based on text length and level
function getPillSize(name: string, level: number): {w: number; h: number} {
  const charWidth = 7.5;
  const padding = 28;
  const textWidth = name.length * charWidth;
  const w = Math.max(textWidth + padding, level === 5 ? 90 : 70);
  const h = level === 5 ? 38 : level === 4 ? 34 : 30;
  return { w, h };
}

// Build edges from connections
const edges: {from: string; to: string}[] = [];
const edgeSet = new Set<string>();
siteConfig.expertise.forEach(skill => {
  skill.connections.forEach(conn => {
    const key = [skill.name, conn].sort().join('|');
    if (!edgeSet.has(key) && nodePositions[conn]) {
      edgeSet.add(key);
      edges.push({ from: skill.name, to: conn });
    }
  });
});
---

<section id="expertise" class="py-20 px-6 md:px-12 lg:px-20" style="background-color: var(--color-surface-light);">
  <div class="max-w-5xl mx-auto">
    <h2 class="reveal text-sm uppercase tracking-[0.2em] font-medium mb-2" style="color: var(--color-accent);" data-i18n="expertise.heading">Expertise</h2>
    <p class="reveal stagger-1 text-2xl md:text-3xl font-bold mt-4 mb-12" style="color: var(--color-primary-dark);" data-i18n="expertise.subtitle">
      Knowledge Architecture
    </p>

    <!-- Desktop: SVG Knowledge Graph with pills -->
    <div class="reveal stagger-2 hidden md:block" id="kg-container">
      <svg viewBox="0 0 850 470" class="w-full" id="knowledge-graph" aria-label="Interactive knowledge graph showing skills and their connections">
        <!-- Edges -->
        {edges.map((edge, i) => {
          const from = nodePositions[edge.from];
          const to = nodePositions[edge.to];
          if (!from || !to) return null;
          return (
            <line
              class="kg-edge"
              x1={from.x} y1={from.y}
              x2={to.x} y2={to.y}
              stroke="var(--color-primary-light)"
              stroke-width="1"
              opacity="0.35"
              style={`animation-delay: ${i * 50}ms;`}
              data-from={edge.from}
              data-to={edge.to}
            />
          );
        })}

        <!-- Nodes as rounded pills -->
        {siteConfig.expertise.map((skill, i) => {
          const pos = nodePositions[skill.name];
          if (!pos) return null;
          const pill = getPillSize(skill.name, skill.level);
          const fillColor = skill.category === 'core' ? 'var(--color-primary-dark)' :
                           skill.category === 'semantic' ? 'var(--color-primary)' :
                           skill.category === 'ai' ? 'var(--color-accent)' :
                           'var(--color-primary-light)';
          const textColor = skill.category === 'tools' ? 'var(--color-primary-dark)' : '#fff';
          const fontSize = skill.level === 5 ? 12 : skill.level === 4 ? 11 : 10;
          return (
            <g class="kg-node cursor-pointer" data-skill={skill.name}
               style={`animation-delay: ${200 + i * 80}ms;`}>
              <rect
                x={pos.x - pill.w / 2}
                y={pos.y - pill.h / 2}
                width={pill.w}
                height={pill.h}
                rx={pill.h / 2}
                ry={pill.h / 2}
                fill={fillColor}
                opacity="0.92"
              />
              <text
                x={pos.x}
                y={pos.y + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={textColor}
                font-size={fontSize}
                font-family="'Space Grotesk', sans-serif"
                font-weight="500"
              >
                {skill.name}
              </text>
            </g>
          );
        })}
      </svg>

      <!-- Legend -->
      <div class="flex items-center justify-center gap-6 mt-6 text-xs" style="color: #888;">
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-full" style="background-color: var(--color-primary-dark);"></div>
          <span data-i18n="expertise.legend.core">Core</span>
        </div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-full" style="background-color: var(--color-primary);"></div>
          <span data-i18n="expertise.legend.semantic">Semantic Web</span>
        </div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-full" style="background-color: var(--color-accent);"></div>
          <span data-i18n="expertise.legend.ai">AI / NLP</span>
        </div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-full" style="background-color: var(--color-primary-light);"></div>
          <span data-i18n="expertise.legend.tools">Tools</span>
        </div>
      </div>
    </div>

    <!-- Mobile: Skill list with level bars -->
    <div class="md:hidden space-y-3">
      {siteConfig.expertise.map((skill, i) => (
        <div class={`reveal stagger-${Math.min(i + 1, 6)} flex items-center gap-3 p-3 rounded-lg`}
             style="background-color: var(--color-surface); border: 1px solid var(--color-primary-light);">
          <div class="flex-1">
            <div class="text-sm font-medium" style="color: var(--color-primary-dark);">{skill.name}</div>
          </div>
          <div class="flex gap-1">
            {Array.from({length: 5}).map((_, j) => (
              <div class={`w-2 h-5 rounded-sm ${j < skill.level ? '' : 'opacity-15'}`}
                   style={`background-color: ${
                     skill.category === 'core' ? 'var(--color-primary-dark)' :
                     skill.category === 'semantic' ? 'var(--color-primary)' :
                     skill.category === 'ai' ? 'var(--color-accent)' :
                     'var(--color-primary-light)'
                   };`}></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animate knowledge graph on scroll
  const kgContainer = document.getElementById('kg-container');
  if (kgContainer) {
    const kgObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          kgContainer.querySelectorAll('.kg-node, .kg-edge').forEach(el => {
            el.classList.add('visible');
          });
          kgObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    kgObserver.observe(kgContainer);
  }

  // Hover interaction: highlight connected nodes
  document.querySelectorAll('.kg-node').forEach(node => {
    node.addEventListener('mouseenter', () => {
      const skillName = node.getAttribute('data-skill');
      document.querySelectorAll('.kg-node').forEach(n => (n as HTMLElement).style.opacity = '0.3');
      document.querySelectorAll('.kg-edge').forEach(e => (e as HTMLElement).style.opacity = '0.08');
      (node as HTMLElement).style.opacity = '1';
      document.querySelectorAll('.kg-edge').forEach(edge => {
        const from = edge.getAttribute('data-from');
        const to = edge.getAttribute('data-to');
        if (from === skillName || to === skillName) {
          (edge as HTMLElement).style.opacity = '0.7';
          (edge as HTMLElement).style.strokeWidth = '2';
          const connectedName = from === skillName ? to : from;
          document.querySelector(`.kg-node[data-skill="${connectedName}"]`)?.setAttribute('style', 'opacity: 1;');
        }
      });
    });

    node.addEventListener('mouseleave', () => {
      document.querySelectorAll('.kg-node').forEach(n => (n as HTMLElement).style.opacity = '');
      document.querySelectorAll('.kg-edge').forEach(e => {
        (e as HTMLElement).style.opacity = '';
        (e as HTMLElement).style.strokeWidth = '';
      });
    });
  });
</script>
