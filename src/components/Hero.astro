---
import { siteConfig } from "../config";
---

<section id="hero" class="min-h-[90vh] flex items-center px-6 md:px-12 lg:px-20 py-16" style="background-color: var(--color-surface-light);">
  <div class="max-w-6xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <!-- Text column -->
    <div class="order-2 md:order-1">
      <h1 class="hero-name text-4xl md:text-5xl lg:text-6xl font-bold leading-tight" style="color: var(--color-primary-dark);">
        {siteConfig.name}
      </h1>
      <p class="hero-title mt-4 text-lg md:text-xl font-medium" style="color: var(--color-primary);" data-i18n="hero.title">
        {siteConfig.title}
      </p>
      <p class="hero-tagline mt-6 text-base md:text-lg leading-relaxed max-w-lg" style="color: #555;" data-i18n="hero.tagline">
        {siteConfig.tagline}
      </p>

      <!-- Stats -->
      <div class="hero-stats mt-8 flex gap-6 md:gap-8">
        {siteConfig.stats.map((stat, i) => (
          <div class="text-center">
            <div class="text-2xl md:text-3xl font-bold font-['Space_Grotesk']" style="color: var(--color-accent);">
              {stat.value}
            </div>
            <div class="text-xs mt-1 uppercase tracking-wider" style="color: var(--color-primary-light);" data-i18n={`hero.stat.${i}`}>
              {stat.label}
            </div>
          </div>
        ))}
      </div>

      <!-- Social links -->
      <div class="hero-social mt-8 flex gap-4">
        {siteConfig.social.email && (
          <a href={`mailto:${siteConfig.social.email}`} class="p-2 rounded-full border transition-all hover:scale-105"
             style="border-color: var(--color-primary-light); color: var(--color-primary);" aria-label="Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M22 6L12 13L2 6" />
            </svg>
          </a>
        )}
        {siteConfig.social.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" class="p-2 rounded-full border transition-all hover:scale-105"
             style="border-color: var(--color-primary-light); color: var(--color-primary);" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z" />
            </svg>
          </a>
        )}
        {siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener" class="p-2 rounded-full border transition-all hover:scale-105"
             style="border-color: var(--color-primary-light); color: var(--color-primary);" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
        )}
        {siteConfig.social.orcid && (
          <a href={siteConfig.social.orcid} target="_blank" rel="noopener" class="p-2 rounded-full border transition-all hover:scale-105"
             style="border-color: var(--color-primary-light); color: var(--color-primary);" aria-label="ORCID">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 01-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.547-.872-3.722-3.891-3.722h-2.428z" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Photo column -->
    <div class="order-1 md:order-2 flex justify-center">
      <div class="hero-photo relative">
        <img
          src="/profile.png"
          alt={siteConfig.name}
          class="w-64 h-64 md:w-80 md:h-80 object-cover object-center rounded-2xl"
          style={`background-color: var(--color-surface-light); box-shadow: 0 24px 48px -12px rgba(66, 39, 78, 0.15);`}
          loading="eager"
        />
        <!-- Decorative node dots -->
        <div class="absolute -top-3 -right-3 w-6 h-6 rounded-full opacity-60" style="background-color: var(--color-primary-light);"></div>
        <div class="absolute -bottom-2 -left-2 w-4 h-4 rounded-full opacity-40" style="background-color: var(--color-accent);"></div>
        <div class="absolute top-1/2 -right-6 w-3 h-3 rounded-full opacity-30" style="background-color: var(--color-primary);"></div>
      </div>
    </div>
  </div>
</section>
