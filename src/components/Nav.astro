---
import { siteConfig } from "../config";
---

<!-- Top bar (visible initially) -->
<nav class="w-full py-4 px-6 flex items-center justify-between" id="top-nav">
  <a href="#" class="font-['Space_Grotesk'] text-sm font-medium tracking-wide" style="color: var(--color-primary-dark);">
    K.A.
  </a>
  <div class="hidden md:flex items-center gap-6 text-sm" style="color: var(--color-primary);">
    <a href="#about" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.about">About</a>
    <a href="#expertise" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.expertise">Expertise</a>
    <a href="#research" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.research">Research</a>
    <a href="#experience" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.experience">Experience</a>
    <a href="#beyond" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.beyond">Beyond</a>
    <a href="#contact" class="link-underline hover:opacity-80 transition-opacity" data-i18n="nav.contact">Contact</a>
    <!-- Language switcher -->
    <div class="lang-switcher flex items-center gap-1 ml-2 pl-2" style="border-left: 1px solid var(--color-primary-light);">
      <button class="lang-btn active" data-lang="en" aria-label="English">EN</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="es" aria-label="Español">ES</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="de" aria-label="Deutsch">DE</button>
    </div>
  </div>
  <div class="flex items-center gap-3 md:hidden">
    <!-- Mobile language switcher -->
    <div class="lang-switcher flex items-center gap-1 text-xs">
      <button class="lang-btn active" data-lang="en" aria-label="English">EN</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="es" aria-label="Español">ES</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="de" aria-label="Deutsch">DE</button>
    </div>
    <button id="mobile-menu-btn" class="p-2" aria-label="Toggle menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="3" y1="6" x2="17" y2="6" />
        <line x1="3" y1="10" x2="17" y2="10" />
        <line x1="3" y1="14" x2="17" y2="14" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-50 hidden" style="background-color: var(--color-surface);">
  <div class="flex flex-col items-center justify-center h-full gap-8">
    <a href="#about" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.about">About</a>
    <a href="#expertise" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.expertise">Expertise</a>
    <a href="#research" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.research">Research</a>
    <a href="#experience" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.experience">Experience</a>
    <a href="#beyond" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.beyond">Beyond</a>
    <a href="#contact" class="text-xl font-medium mobile-link" style="color: var(--color-primary-dark);" data-i18n="nav.contact">Contact</a>
    <button id="mobile-close-btn" class="mt-8 text-sm" style="color: var(--color-primary);" data-i18n="nav.close">Close</button>
  </div>
</div>

<!-- Floating pill nav (appears on scroll) -->
<div id="floating-nav" class="fixed top-4 left-1/2 -translate-x-1/2 z-40 hidden opacity-0">
  <div class="flex items-center gap-4 px-6 py-2.5 rounded-full shadow-lg backdrop-blur-md text-sm"
       style="background-color: rgba(250, 250, 248, 0.92); border: 1px solid var(--color-primary-light);">
    <a href="#" class="font-['Space_Grotesk'] font-medium" style="color: var(--color-primary-dark);">K.A.</a>
    <span class="w-px h-4" style="background-color: var(--color-primary-light);"></span>
    <a href="#about" class="hover:opacity-70 transition-opacity" style="color: var(--color-primary);" data-i18n="nav.about">About</a>
    <a href="#expertise" class="hover:opacity-70 transition-opacity" style="color: var(--color-primary);" data-i18n="nav.expertise">Expertise</a>
    <a href="#research" class="hover:opacity-70 transition-opacity" style="color: var(--color-primary);" data-i18n="nav.research">Research</a>
    <a href="#experience" class="hover:opacity-70 transition-opacity" style="color: var(--color-primary);" data-i18n="nav.experience">Experience</a>
    <a href="#contact" class="hover:opacity-70 transition-opacity" style="color: var(--color-primary);" data-i18n="nav.contact">Contact</a>
    <!-- Floating nav language switcher -->
    <span class="w-px h-4" style="background-color: var(--color-primary-light);"></span>
    <div class="lang-switcher flex items-center gap-1">
      <button class="lang-btn active" data-lang="en">EN</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="es">ES</button>
      <span style="color: var(--color-primary-light);">|</span>
      <button class="lang-btn" data-lang="de">DE</button>
    </div>
  </div>
</div>

<script>
  // Floating nav on scroll
  const floatingNav = document.getElementById('floating-nav');
  let lastScrollY = 0;

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 400) {
      floatingNav?.classList.remove('hidden');
      floatingNav?.classList.add('header-visible');
    } else {
      floatingNav?.classList.add('hidden');
      floatingNav?.classList.remove('header-visible');
    }
    lastScrollY = scrollY;
  });

  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileClose = document.getElementById('mobile-close-btn');

  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  };

  mobileClose?.addEventListener('click', closeMenu);
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
