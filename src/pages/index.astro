---
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import ExpertiseGraph from "../components/ExpertiseGraph.astro";
import Research from "../components/Research.astro";
import Experience from "../components/Experience.astro";
import BeyondWork from "../components/BeyondWork.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import { translations } from "../i18n";
import "../styles/global.css";
---

<html lang="en" style={`--color-primary-dark:${siteConfig.colors.primaryDark};--color-primary:${siteConfig.colors.primary};--color-primary-light:${siteConfig.colors.primaryLight};--color-accent:${siteConfig.colors.accent};--color-surface:${siteConfig.colors.surface};--color-surface-light:${siteConfig.colors.surfaceLight}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${siteConfig.name} — ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/profile.png" />

    <!-- Fonts: Space Grotesk + DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} — {siteConfig.title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <About />
      <ExpertiseGraph />
      <Research />
      <Experience />
      <BeyondWork />
    </main>
    <Footer />

    <!-- i18n translations data -->
    <script define:vars={{ translations }}>
      window.__i18n = translations;
    </script>

    <!-- i18n switcher logic -->
    <script>
      const i18n = (window as any).__i18n as Record<string, Record<string, string>>;
      const defaultTexts = new Map<Element, string>();

      // Store original English texts
      document.querySelectorAll('[data-i18n]').forEach(el => {
        defaultTexts.set(el, el.textContent || '');
      });

      function setLanguage(lang: string) {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n')!;
          if (lang === 'en') {
            el.textContent = defaultTexts.get(el) || '';
          } else if (i18n[lang]?.[key]) {
            el.textContent = i18n[lang][key];
          }
          // If no translation exists for this key, keep current text
        });

        // Update html lang attribute
        document.documentElement.lang = lang;

        // Update all language switcher buttons
        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
        });

        // Persist choice
        localStorage.setItem('lang', lang);
      }

      // Attach click handlers to all language buttons
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang');
          if (lang) setLanguage(lang);
        });
      });

      // Restore saved language preference
      const savedLang = localStorage.getItem('lang');
      if (savedLang && savedLang !== 'en' && i18n[savedLang]) {
        setLanguage(savedLang);
      }
    </script>

    <!-- Scroll Reveal -->
    <script>
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -10% 0px',
        threshold: 0.1
      };

      const revealOnScroll = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(revealOnScroll, observerOptions);
      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
